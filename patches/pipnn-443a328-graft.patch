+  if (deg == kMaxDegree) { wi = static_cast<size_t>(sentinel->hash); wvalid = true; }
+  for (const auto& cand : r) {
+    const indexType pid = cand.first;
+    const float db = static_cast<float>(Eigen::bfloat16(static_cast<float>(cand.second)));
