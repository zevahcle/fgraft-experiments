+template<typename rangeType>
+void merge_neighbors_det(const size_t i, const rangeType& r) {
+  locks[i].Lock();
+  const size_t base = i * (kMaxDegree + 1);
+  T* const sentinel = &tables[base];
+  T* const begin = &tables[base + 1];
+  size_t deg = static_cast<size_t>(sentinel->point_id);
+  auto key = [](float d, indexType id) { return std::make_pair(d, id); };
+  auto kf = [](const T& t) { return static_cast<float>(t.norm); };
